# RETIRED -- THIS IS NOT THE UNIT THAT RUNS. Kept for reference only; do not edit it to change
# production (a MemoryMax added here reaches nothing).
#
# The stand-in on claude-dev was disabled when the mcp-google LXC went live (2026-07-04). The live
# unit is moprox-homelab `services/mcp-google/systemd/mcp-google.service`, installed on host
# mcp-google (CTID 107, 192.168.1.223) as /etc/systemd/system/mcp-google.service; verified
# byte-identical to that repo copy on 2026-11-26 (i-20261126-144341). Its config is
# /etc/mcp-google/mcp-google.env on the guest.
#
# The *-patch.py scripts in this directory ARE live: they are run by hand against the LXC's venv
# (see each script's docstring), e.g. from claude-dev:
#   ssh -i ~/.ssh/claude-dev-ops agent@192.168.1.223 'sudo /opt/mcp-google/venv/bin/python -' < <patch>.py
#   ssh ... 'sudo systemctl restart mcp-google'
#
# What the stand-in was: Google Workspace MCP (read-broad, write-narrow) on claude-dev. Service
# account + domain-wide delegation, impersonating one Workspace user; no OAuth2.1 (incompatible
# with SA), bound to the trusted subnet.
[Unit]
Description=Google Workspace MCP (workspace-mcp) — STAND-IN on claude-dev (read + gmail drafts + calendar events)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=mikael
Environment=HOME=/home/mikael
Environment=GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/home/mikael/.config/claude-dev/google-sa.json
Environment=USER_GOOGLE_EMAIL=mikael@odinlake.net
Environment="WORKSPACE_MCP_PERMISSIONS=gmail:drafts calendar:events drive:readonly docs:readonly"
Environment=WORKSPACE_MCP_HOST=0.0.0.0
Environment=WORKSPACE_MCP_PORT=8000
WorkingDirectory=/opt/mcp-google
ExecStart=/opt/mcp-google/venv/bin/workspace-mcp --transport streamable-http
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
