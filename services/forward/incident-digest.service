# Daily: watchdog-overdue alert only; Mondays the weekly roundup of triage categories (since 2026-10-28).
# Triggered by incident-digest.timer. Install to /etc/systemd/system/.
[Unit]
Description=moprox incident digest (watchdog alert daily, triage roundup weekly)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=mikael
Environment=HOME=/home/mikael
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/mikael/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/moprox-tooling/services/forward/incident_digest.py
