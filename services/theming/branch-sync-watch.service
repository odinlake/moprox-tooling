# Pick up the theming repo's branch-sync status and post conflicts to Discord (#exocomps).
# The workflow deliberately does not fail on a conflict, so nothing goes red in GitHub's UI —
# this is what turns that status artifact into a message a human sees. Install to /etc/systemd/system/.
[Unit]
Description=moprox theming branch-sync watcher (conflicts -> Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mikael
Environment=HOME=/home/mikael
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/mikael/.config/claude-dev/discord.env
ExecStart=/usr/bin/python3 /opt/moprox-tooling/services/theming/branch_sync_watch.py
# This used to be a fetch-and-post that finished in seconds, so the systemd default of 90s was
# invisible. It now wakes the theming agent for a new conflict — up to 3 runs at a 900s timeout
# each — and at the default this unit would be KILLED mid-resolution, leaving a half-done merge in
# the agent's checkout and a "conflict dispatched" line with nothing behind it.
TimeoutStartSec=3600
