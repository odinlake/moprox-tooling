# Retire ai-feature-* branches in theme-ontology/theming that are finished with: PR merged, PR
# closed unmerged, or no PR and no commit for a fortnight. A garbage collector, not a rule — a
# branch with no PR that is still moving is left alone. Install to /etc/systemd/system/.
# See branch_housekeeping.py for the policy and its reasoning.
[Unit]
Description=moprox theming ai-feature branch housekeeping (retire finished/abandoned branches)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mikael
Environment=HOME=/home/mikael
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/mikael/.config/claude-dev/discord.env
ExecStart=/usr/bin/python3 /opt/moprox-tooling/services/theming/branch_housekeeping.py
# Two `gh` calls plus one per ai-feature branch; seconds in practice. Bounded so a hung API call
# cannot sit here until the next day's firing.
TimeoutStartSec=600
