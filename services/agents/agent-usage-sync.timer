# Every 10 minutes. The loop wakes hourly and the dashboard rebuilds every 2 minutes, so this is
# comfortably fine-grained for the Stats tab while keeping one ssh per pull, not one per rebuild.
[Unit]
Description=Pull other hosts' agent usage ledgers every 10 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
