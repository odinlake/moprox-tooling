# One bounded cycle of a continuous agent. Templated: loop@analyst, loop@burndown.
# Oneshot per cycle deliberately — systemd owns the cgroup, so killing a stuck cycle reaps the
# children claude spawns (bash/node) instead of orphaning them.
[Unit]
Description=moprox continuous agent cycle (%i)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=mikael
Environment=HOME=/home/mikael
Environment=PYTHONUNBUFFERED=1
# Raised 8 -> 16 on 2026-08-17, at the operator's call, when the two per-cycle refuters began
# being ledgered (9eddaf9c98). They always cost this much; only now does spent_recently() see
# them, so the old cap would have quietly halved the cadence to ~2 cycles per 5 h. Raising it
# keeps the loop at ~4 while the accounting stays honest. This is a share of the Max plan's
# ~5 h window, not a bill — spending more here is crowding coach/valet, not money.
Environment=LOOP_BUDGET_CAP_USD=16
# systemd does NOT read /etc/environment, and on a Squid-contained box that file is where the proxy
# lives — without it claude has no route to the API at all: it retries silently, emits no events and
# no stderr, and looks exactly like a hung agent until the idle watchdog fires. Same trap use-squid.sh
# already documents for claude-remote. Optional ('-') so this works pre-cutover too, and it tracks
# the cutover automatically because use-squid.sh apply/undo owns that file.
EnvironmentFile=-/etc/environment
# Loop chatter goes to the dedicated firehose group, NOT the operator's DM. tg.py reads
# TELEGRAM_CHAT_ID from the environment, so redirecting it needs no code change.
EnvironmentFile=-/home/mikael/.config/claude-dev/telegram-firehose.env
# ~/.local/bin is NOT on systemd's default PATH and the claude CLI lives there since the native
# installer — the exact omission that scored 1,200 local-news posts as 0 for three weeks.
Environment=PATH=/home/mikael/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Backstop only; the harness's idle watchdog is the one that distinguishes stuck from slow.
TimeoutStartSec=7200
KillMode=control-group
ExecStart=/usr/bin/python3 /home/mikael/projects/moprox-tooling/services/loop/loop.py %i
