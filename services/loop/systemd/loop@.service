# One bounded loop cycle for agent %i. Templated: loop@analyst, loop@burndown, …
# DO NOT enable this on claude-dev — it holds data credentials, and the harness executes
# model-authored verifier commands. It belongs on the contained loop guest (CT 114).
[Unit]
Description=loop cycle for %i (propose -> harness-verified -> ledger)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mikael
Environment=HOME=/home/mikael
Environment=PYTHONUNBUFFERED=1
# ~/.local/bin is NOT on systemd's default PATH, and the claude CLI lives there since the native
# installer. Omitting this is what scored 1,200 local-news posts as 0 for three weeks.
Environment=PATH=/home/mikael/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Loop chatter goes to the dedicated firehose group, NOT the operator's DM. tg.py reads this from
# the environment, so redirecting it needs no code change.
EnvironmentFile=-/home/mikael/.config/claude-dev/telegram-firehose.env
ExecStart=/usr/bin/python3 /home/mikael/projects/moprox-tooling/services/loop/harness.py %i

[Install]
WantedBy=multi-user.target
