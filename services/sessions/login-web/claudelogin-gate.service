# Re-apply the claude-login ingress gate at boot. claude-login-web.service Requires= this.
# Source of truth: moprox-tooling/services/sessions/login-web.
[Unit]
Description=claude-login ingress gate (nftables) -- web box only
After=nftables.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/nftables-claudelogin.conf
ExecReload=/usr/sbin/nft -f /etc/nftables-claudelogin.conf
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
