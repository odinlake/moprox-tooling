# Recycle the moprox coach session weekly, Friday 03:00. one=Tue, two=Wed, three=Thu, coach=Fri, so
# only one registration rotates per day and no two sessions are ever restarting together.
# Activates moprox-dev-cycle@coach.service.
[Unit]
Description=Weekly recycle of moprox coach (Fri 03:00)

[Timer]
OnCalendar=Fri *-*-* 03:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
