# Off the :00/:05 grid on purpose, so it does not start alongside polar-fetch (every 5 min). An
# overlap is safe anyway: scratch files are keyed per pid and the index is written by tmp+replace.
[Unit]
Description=Run the Wattbike Hub pull once a day
[Timer]
OnCalendar=*-*-* 20:17 UTC
Persistent=true
[Install]
WantedBy=timers.target
